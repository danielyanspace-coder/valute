# Backend
PORT=8080
# Bot token from @BotFather — used to verify Telegram initData
TELEGRAM_BOT_TOKEN=
# Wallet rate (home screen, ruble withdrawals) = Rapira USDT/RUB ask * (1 + X%). Negative X gives a rate below the exchange
RATE_WALLET_MARKUP_PERCENT=5
# Rate for paying SBP QR codes from the USDT balance = Rapira bid * (1 - X%)
RATE_QR_PAY_DISCOUNT_PERCENT=5
# How often to poll Rapira, ms
RATE_POLL_MS=15000
# Allow requests without Telegram initData (local browser dev only!)
ALLOW_DEV_AUTH=false

# Password for the admin panel at /admin (and /api/admin/*). Long random string; empty disables admin
ADMIN_TOKEN=
# Your own Telegram ID (ask @userinfobot): broadcasts are test-sent to you first
ADMIN_TELEGRAM_ID=

# Telegram username of support (without @): users with a hidden username are sent there
SUPPORT_USERNAME=
# HTTPS address of the Mini App; adds an "Открыть кошелёк" button to bot notifications
WEBAPP_URL=
# SQLite database file (relative to backend/ or absolute)
DATABASE_PATH=data/wallet.db

# Free AML layer: Tether blacklist via JSON-RPC (public nodes by default) + OFAC list
TRON_RPC_URL=https://tron-rpc.publicnode.com/jsonrpc
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# Optional free key: https://go.chainalysis.com/crypto-sanctions-screening.html
CHAINALYSIS_SANCTIONS_API_KEY=

# Bot username without @ (the bot reports it itself on start; this is a fallback for check links)
BOT_USERNAME=

# Deposits (USDT TRC-20 only): smaller incoming transfers are not credited (sweeping them costs more than they are worth)
DEPOSIT_MIN_USDT=0
# USDT TRC-20 withdrawal: fee on top of the amount (covers the TRX you burn sending it) and minimum amount
USDT_WITHDRAW_FEE=5
USDT_WITHDRAW_MIN=10
# Deposit addresses are added in the admin panel (Пополнения -> Адреса), not here.
# Only public addresses (T...) go to the server, seed phrases stay in your wallet app.
# Deposit watcher (TronGrid). Free API key: https://www.trongrid.io (works without it, slower)
TRONGRID_API_KEY=
DEPOSIT_POLL_MS=5000
DEPOSIT_BATCH=3

# Animated emoji in bot messages (like Crypto Bot). Needs a collectible username from fragment.com
# attached to the bot. Get ids: send the emoji to the bot from ADMIN_TELEGRAM_ID, it replies with them.
# Keys: deposit received withdraw success cancel pending clock warning urgent critical check usdt lock unlock support hold rocket gift
CUSTOM_EMOJI=off
CUSTOM_EMOJI_IDS=

# Fines, parking, Steam: the user pays this % less USDT than at the Rapira price
SERVICES_DISCOUNT_PERCENT=10
