# Backend
PORT=8080
# Bot token from @BotFather — used to verify Telegram initData
TELEGRAM_BOT_TOKEN=
# Buy rate (home screen, deposits) = Rapira USDT/RUB ask * (1 + X%)
RATE_BUY_MARKUP_PERCENT=5
# Sell rate (paying by SBP QR from USDT balance) = Rapira bid * (1 - X%)
RATE_SELL_DISCOUNT_PERCENT=5
# How often to poll Rapira, ms
RATE_POLL_MS=15000
# Allow requests without Telegram initData (local browser dev only!)
ALLOW_DEV_AUTH=false
